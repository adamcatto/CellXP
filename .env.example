ENVIRONMENT=development
RUNTIME_BACKEND=queued
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cellxp
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_URL=file:///tmp/cellxp-artifacts
JOB_STREAM=cellxp:jobs
JOB_CONSUMER_GROUP=cellxp-workers
GRAPH_JOB_STREAM=cellxp:graph-commands
GRAPH_CONSUMER_GROUP=cellxp-graph-executors
ALPHAGENOME_SERVICE_URL=http://localhost:8106
EVO2_SERVICE_URL=http://localhost:8107
STRUCTURE_SERVICE_URL=http://localhost:8102
GWAS_SERVICE_URL=http://localhost:8103
CRISPR_SERVICE_URL=http://localhost:8105

# Packaged sequence-model workers
# ALPHAGENOME_API_KEY=                 # required by the official hosted AlphaGenome client
EVO2_WEIGHT_PATH=/opt/cellxp/models/evo2_7b.pt
EVO2_BATCH_SIZE=1
EVO2_USE_KERNELS=0

# Opt-in structure GPU worker (ESMFold/Boltz-2)
STRUCTURE_BACKEND=none
STRUCTURE_DEVICE=cuda
STRUCTURE_JOB_TIMEOUT_SECONDS=1800
MODEL_CACHE_DIR=/opt/cellxp/models
ESMFOLD_REVISION=75a3841ee059df2bf4d56688166c8fb459ddd97a
# BOLTZ_EXECUTABLE=boltz

# Reasoning LLM (agent brain) — see specs/services/llm_service.md
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:4b
# Remote provider opt-in (leave unset to stay local/offline):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
