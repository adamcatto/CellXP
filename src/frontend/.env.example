# Same-origin API (proxied to uvicorn by next.config rewrites). Works from localhost
# and from LAN IPs (e.g. http://10.x.x.x:3000) without pointing the browser at 127.0.0.1.
# Copy to .env.local and restart `npm run dev` after changes.
NEXT_PUBLIC_API_BASE=/api/v1

# Server-only: where Next.js proxies /api/v1 (not exposed to the browser).
CELLXP_API_PROXY_TARGET=http://127.0.0.1:8001

# Optional extra dev origins (comma-separated hostnames/IPs). next.config.ts already
# auto-includes 127.0.0.1 and this machine's LAN IPv4 addresses for HMR/hydration.
# CELLXP_DEV_ORIGINS=my-dev-box.local
