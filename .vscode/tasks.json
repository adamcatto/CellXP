{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev-api",
      "type": "shell",
      "command": "./scripts/dev_api.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "cellxp",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Uvicorn running on",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "cellxp-dev"
      }
    },
    {
      "label": "dev-frontend",
      "type": "shell",
      "command": "./scripts/dev_frontend.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "cellxp",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "cellxp-dev"
      }
    },
    {
      "label": "dev: full stack",
      "dependsOn": ["dev-api", "dev-frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
